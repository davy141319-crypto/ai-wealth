# Redirect pnpm store & metadata cache into sandbox-writable locations
# (the default %LOCALAPPDATA%\pnpm-cache is outside the sandbox writable set).
store-dir=C:/Users/hp/.local/state/pnpm/store
cache-dir=C:/Users/hp/.local/state/pnpm/cache
# Hoist nothing extra; workspace links are isolated.
node-linker=isolated
