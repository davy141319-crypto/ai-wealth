// ============================================================================
// AI Wealth DApp — Prisma schema
// ----------------------------------------------------------------------------
// P1-001 — Core database models.
//
// Scope: identity / auth-nonce / audit / idempotency / system-config ONLY.
// FORBIDDEN in this schema (hard constraint): real USDT balance, deposit,
// withdrawal, wealth product, income, points, tasks, invitation, team, V1-V5,
// gambling, sports, e-sports, lottery, live entertainment, or ANY real fund
// field. Those arrive in later phases and must be testnet-verified first.
//
// CONVENTION — unified time handling (applies to EVERY model):
//   createdAt DateTime @default(now())   @map("created_at")
//   updatedAt DateTime @updatedAt        @map("updated_at")
//   - @default(now())  => set once by Postgres at INSERT (UTC)
//   - @updatedAt       => auto-refreshed by a Postgres trigger Prisma emits (UTC)
//   - @map(...) keeps TS fields camelCase while DB columns stay snake_case
// Do NOT set created_at/updated_at manually in application code.
//
// Primary keys: UUID v4 (@default(uuid())). Opaque, collision-safe, and
// non-enumerable (no sequential id leaking row counts / order).
//
// Foreign keys: onDelete restrict by default to prevent accidental data loss;
// wallet-owned children (WalletIdentity, AuthNonce) cascade with their wallet
// only when the wallet itself is deleted (which is itself restricted by the
// user FK). This keeps the audit trail and idempotency records durable.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

/// User lifecycle status. Drives access gates and visibility.
enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  CLOSED
}

/// Supported blockchain identifiers. Extend carefully; new chains require
/// listener + custody review. No fund fields here — chain is identity only.
enum Chain {
  ETH
  BSC
  TRON
  POLYGON
  ARBITRUM
}

/// Wallet state machine. Only CONNECTED wallets may be used for SIWE auth.
enum WalletStatus {
  CONNECTED
  DISCONNECTED
  REVOKED
}

/// Mechanism used to prove ownership of a wallet address.
enum IdentityType {
  SIWE
  MESSAGE_SIGNATURE
}

/// Lifecycle of an idempotency record.
enum IdempotencyStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Typed value encoding for SystemConfig rows.
enum SystemConfigValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

// ----------------------------------------------------------------------------
// 1. User — the human actor. No credentials stored here (auth is wallet-based).
// ----------------------------------------------------------------------------
model User {
  id          String     @id @default(uuid()) @db.Uuid
  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?  @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  wallets   Wallet[]
  auditLogs AuditLog[]

  @@map("users")
}

// ----------------------------------------------------------------------------
// 2. Wallet — a blockchain address bound to a user. Identity only (no balance).
//    UNIQUE(address, chain, network): the same address on a different network
//    is a distinct wallet row (e.g. USDT-ERC20 vs USDT-TRC20 live on different
//    networks even when chained under ETH/TRON).
// ----------------------------------------------------------------------------
model Wallet {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  address    String       @db.VarChar(64)
  chain      Chain
  network    String       @db.VarChar(32) // e.g. "mainnet", "sepolia", "trc20-main"
  status     WalletStatus @default(CONNECTED)
  isPrimary  Boolean      @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  identities WalletIdentity[]
  nonces     AuthNonce[]

  @@unique([address, chain, network], map: "wallet_address_chain_network_uq")
  @@index([userId], map: "wallet_user_id_idx")
  @@map("wallets")
}

// ----------------------------------------------------------------------------
// 3. WalletIdentity — proof-of-ownership records attached to a wallet.
//    A wallet may have multiple identity types (e.g. SIWE + a raw signature).
//    Each (walletId, identityType) pair is unique: one verified proof per type.
// ----------------------------------------------------------------------------
model WalletIdentity {
  id           String       @id @default(uuid()) @db.Uuid
  walletId     String       @map("wallet_id") @db.Uuid
  wallet       Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  identityType IdentityType @map("identity_type")
  verifiedAt   DateTime     @default(now()) @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@unique([walletId, identityType], map: "wallet_identity_wallet_type_uq")
  @@index([walletId], map: "wallet_identity_wallet_idx")
  @@map("wallet_identities")
}

// ----------------------------------------------------------------------------
// 4. AuthNonce — single-use challenge nonce for wallet sign-in.
//    `nonce` is globally UNIQUE (cryptographically random). A nonce expires
//    (expiresAt) and is single-use (usedAt set on consumption). Expired/used
//    nonces MUST be rejected by the auth service.
// ----------------------------------------------------------------------------
model AuthNonce {
  id        String    @id @default(uuid()) @db.Uuid
  walletId  String    @map("wallet_id") @db.Uuid
  wallet    Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  nonce     String    @unique(map: "auth_nonce_nonce_uq") @db.VarChar(64)
  issuedAt  DateTime  @default(now()) @map("issued_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([walletId], map: "auth_nonce_wallet_idx")
  @@index([expiresAt], map: "auth_nonce_expires_idx")
  @@index([usedAt], map: "auth_nonce_used_idx")
  @@map("auth_nonces")
}

// ----------------------------------------------------------------------------
// 5. AuditLog — append-only audit trail. NEVER updated or deleted by app code.
//    `actor` is the user id (nullable for system/anonymous actions).
//    `metadata` is JSONB for flexible structured context; never put secrets.
//    No FK on actor on purpose: audit must survive user deletion (the user
//    table restricts delete while audit rows reference it via `actor`, but
//    we intentionally keep the relation loose so historical audits remain
//    queryable even if a user is later purged).
// ----------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actor      String?  @db.Uuid @map("actor_user_id")
  actorUser  User?    @relation(fields: [actor], references: [id], onDelete: SetNull, onUpdate: Cascade)
  action     String   @db.VarChar(128)
  resource   String   @db.VarChar(128)
  requestId  String?  @map("request_id") @db.VarChar(64)
  ip         String?  @db.VarChar(45) // IPv4 (15) or IPv6 (45)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  metadata   Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([actor], map: "audit_actor_idx")
  @@index([action], map: "audit_action_idx")
  @@index([resource], map: "audit_resource_idx")
  @@index([createdAt], map: "audit_created_at_idx")
  @@index([requestId], map: "audit_request_id_idx")
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// 6. IdempotencyKey — replays a cached response for a repeated request.
//    UNIQUE(scope, key): the same logical operation is deduped per scope.
//    `responseBody` stores the serialized response (JSON-encoded), `status`
//    tracks the in-flight / done state. Expired rows are purged by a worker.
// ----------------------------------------------------------------------------
model IdempotencyKey {
  id            String           @id @default(uuid()) @db.Uuid
  key           String           @db.VarChar(128)
  scope         String           @db.VarChar(64)
  requestHash   String?          @map("request_hash") @db.VarChar(64)
  status        IdempotencyStatus @default(PENDING)
  responseCode  Int?             @map("response_code")
  responseBody  Json?            @map("response_body")
  expiresAt     DateTime         @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@unique([scope, key], map: "idempotency_scope_key_uq")
  @@index([expiresAt], map: "idempotency_expires_idx")
  @@index([status], map: "idempotency_status_idx")
  @@map("idempotency_keys")
}

// ----------------------------------------------------------------------------
// 7. SystemConfig — typed key/value configuration store.
//    `key` is globally UNIQUE. `valueType` tells the reader how to decode
//    `value` (which is always stored as TEXT in the DB).
// ----------------------------------------------------------------------------
model SystemConfig {
  id          String              @id @default(uuid()) @db.Uuid
  key         String              @unique(map: "system_config_key_uq") @db.VarChar(128)
  value       String              @db.Text
  valueType   SystemConfigValueType @default(STRING) @map("value_type")
  description String?             @db.Text
  isActive    Boolean             @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("system_configs")
}

// ----------------------------------------------------------------------------
// INFRASTRUCTURE-ONLY table retained from P0 (migration marker store).
// Kept for backward compatibility with existing deployments; new code should
// prefer SystemConfig for typed config going forward.
// ----------------------------------------------------------------------------
model SystemMeta {
  key   String  @id
  value String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("system_meta")
}
