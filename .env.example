# ============================================================================
# AI Wealth DApp — Environment Variables (EXAMPLE)
# Copy to .env and fill real values. NEVER commit .env or real secrets to Git.
# ============================================================================

# ---- Runtime ----
NODE_ENV=development

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://aiwealth:aiwealth_password@localhost:5432/aiwealth?schema=public
# Host port mapping override (defaults to 5432). Set this if 5432 is already
# in use by another Docker stack on your machine, e.g. POSTGRES_PORT=5433.
POSTGRES_PORT=5432
POSTGRES_USER=aiwealth
POSTGRES_PASSWORD=aiwealth_password
POSTGRES_DB=aiwealth

# ---- Redis ----
REDIS_URL=redis://localhost:6379
# Host port mapping override (defaults to 6379). Set this if 6379 is in use.
REDIS_PORT=6379

# ---- Auth / JWT ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=3600s

# ---- API ----
API_PORT=4000
API_PREFIX=api

# ---- Worker / Blockchain service ports (health endpoints) ----
WORKER_PORT=4001
BLOCKCHAIN_PORT=4002

# ---- Apps (Public URLs used by CORS / redirects) ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001

# ---- BullMQ Worker ----
WORKER_CONCURRENCY=4

# ---- Blockchain listener (placeholder for future phases) ----
# BLOCKCHAIN_RPC_URL=
# CHAIN_ID=
