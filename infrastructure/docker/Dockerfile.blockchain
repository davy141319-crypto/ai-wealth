# ============================================================================
# AI Wealth — Blockchain Listener image (multi-stage, P0 placeholder)
# ============================================================================
FROM node:20.18-alpine AS base
RUN apk add --no-cache libc6-compat openssl tini
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
# Hoisted node-linker ensures project bins (tsc, prisma) resolve in Docker builds
ENV npm_config_node_linker=hoisted
RUN npm install -g pnpm@10.23.0

FROM base AS deps
WORKDIR /repo
COPY pnpm-workspace.yaml pnpm-lock.yaml .npmrc package.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/config/package.json packages/config/
COPY services/blockchain/package.json services/blockchain/
RUN pnpm install --frozen-lockfile

FROM base AS builder
WORKDIR /repo
COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/packages ./packages
COPY --from=deps /repo/services ./services
COPY tsconfig.base.json ./
COPY packages packages
COPY services/blockchain services/blockchain
RUN pnpm --filter @ai-wealth/shared --filter @ai-wealth/config run build
RUN pnpm --filter @ai-wealth/blockchain run build
RUN pnpm --filter @ai-wealth/blockchain deploy --prod /deploy/blockchain

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV BLOCKCHAIN_PORT=4002
RUN addgroup -g 1001 -S nodejs && adduser -S bc -u 1001 -G nodejs
COPY --from=builder /deploy/blockchain ./
USER bc
EXPOSE 4002
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.BLOCKCHAIN_PORT||4002)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/main.js"]
