# ============================================================================
# AI Wealth — BullMQ Worker image (multi-stage)
# Install + build happen in ONE stage so pnpm's node_modules/.bin symlinks
# (tsc, prisma, …) are never carried across a `COPY --from` boundary.
# ============================================================================
FROM node:20.18-alpine AS base
RUN apk add --no-cache libc6-compat openssl tini
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN npm install -g pnpm@10.23.0

# ---------- builder (install + build in the same stage) ----------
FROM base AS builder
WORKDIR /repo
COPY pnpm-workspace.yaml pnpm-lock.yaml .npmrc package.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/config/package.json packages/config/
COPY packages/ui/package.json packages/ui/
COPY services/worker/package.json services/worker/
RUN pnpm install --frozen-lockfile
COPY tsconfig.base.json ./
COPY packages packages
COPY services/worker services/worker
RUN pnpm --filter @ai-wealth/shared --filter @ai-wealth/config --filter @ai-wealth/ui run build
RUN pnpm --filter @ai-wealth/worker run build
RUN pnpm --filter @ai-wealth/worker deploy --prod /deploy/worker

# ---------- runtime ----------
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV WORKER_PORT=4001
RUN addgroup -g 1001 -S nodejs && adduser -S worker -u 1001 -G nodejs
COPY --from=builder /deploy/worker ./
USER worker
EXPOSE 4001
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.WORKER_PORT||4001)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/main.js"]
