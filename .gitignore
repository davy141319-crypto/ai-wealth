# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# Coverage
coverage/

# Local-only pnpm config (sandbox store/cache paths) — NEVER commit
.npmrc.local

# Environment files — NEVER commit secrets
.env
.env.local
.env.*.local
.env.production
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Secrets / keys — NEVER commit
*.pem
*.key
*.p12
secrets/
private/
*.seed
seed-phrase*
# Wallet secret files only (NOT source files like wallet.repository.ts).
# Match wallet-key/seed/priv files by extension + keyword.
wallet-*.json
wallet-*.key
wallet-*.pem
wallet-*.txt
wallet-*.seed
wallet-seed*
wallet-private*
wallet-keystore*
keystore/*
keystore.json
mnemonic*

# Prisma generated client (per-package committed only when intended)
# keep schema.prisma, ignore local generated client when present
packages/database/prisma/migrations/dev.db*

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Docker volumes (local mounts, if any)
docker-data/

# Test / cache
.cache/
.eslintcache
*.lcov
